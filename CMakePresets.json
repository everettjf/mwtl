{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "cacheVariables": {
        "MWTL_BUILD_EXAMPLES": "ON",
        "MWTL_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64",
      "inherits": "vs2026-base",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/presets/x64"
    },
    {
      "name": "vs2026-arm64",
      "displayName": "Visual Studio 2026 ARM64",
      "inherits": "vs2026-base",
      "architecture": "ARM64",
      "binaryDir": "${sourceDir}/build/presets/arm64"
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release"
    },
    {
      "name": "arm64-debug",
      "configurePreset": "vs2026-arm64",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "x64-release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "arm64-debug",
      "configurePreset": "vs2026-arm64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
